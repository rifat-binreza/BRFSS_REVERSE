 Exception:\n","    HAS_XGB = False\n","try:\n","    import shap\n","    HAS_SHAP = True\n","except Exception:\n","    HAS_SHAP = False\n","try:\n","    import matplotlib.pyplot as plt\n","    HAS_PLT = True\n","except Exception:\n","    HAS_PLT = False\n","\n","from sklearn.model_selection import train_test_split, GroupShuffleSplit\n","from sklearn.pipeline import Pipeline\n","from sklearn.compose import ColumnTransformer\n","from sklearn.impute import SimpleImputer\n","from sklearn.preprocessing import OneHotEncoder, StandardScaler\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.ensemble import RandomForestClassifier, StackingClassifier, HistGradientBoostingClassifier\n","from sklearn.neural_network import MLPClassifier\n","from sklearn.inspection import permutation_importance\n","from sklearn.metrics import roc_auc_score, roc_curve, confusion_matrix, brier_score_loss\n","\n","# ------------------------------- configuration -------------------------------\n","SEED = 42\n","DEMO = os.environ.get(\"BRFSS_DEMO\") == \"1\"          # synthetic smoke test (leave off on Kaggle)\n","FAST = True                                          # subsample the two slowest models (RF, Stacked)\n","MAX_TRAIN_FAST = int(os.environ.get(\"BRFSS_MAXTRAIN\", 120_000))\n","STACK_CV = 3\n","N_BOOT = int(os.environ.get(\"BRFSS_NBOOT\", 200))\n","THRESH_RECALL = 0.80                                 # operating point: catch >=80% of target consumers\n","TOP_FRAC = 0.20                                      # marketing view: contact the top 20% highest-scored\n","TARGETS_TO_RUN = [\"smoking\", \"alcohol_any\", \"fitness_any\"]   # add \"alcohol_binge\", \"fitness_guidelines\" for secondary\n","OUT = \"/kaggle/working\" if os.path.isdir(\"/kaggle/working\") else \"outputs\"\n","os.makedirs(OUT, exist_ok=True)\n","print(f\"xgboost={HAS_XGB} shap={HAS_SHAP} plots={HAS_PLT} demo={DEMO} out={OUT}\")\n","\n","def norm_col(c):\n","    \"\"\"Column-name normaliser: handles '_AGEG5YR', 'X.AGEG5YR' (R export) and lower case.\"\"\"\n","    c = str(c).strip().upper()\n","    if c.startswith(\"X.\"): c = \"_\" + c[2:]\n","    elif c.startswith(\"X_\"): c = c[1:]\n","    return c\n","\n","RECODE = {\n","    \"yn12\": lambda s: s.map({1: 1, 2: 0}),          # 1 = yes, 2 = no\n","    \"rf12\": lambda s: s.map({1: 0, 2: 1}),          # CDC calculated risk flags: 1 = no, 2 = yes\n","    \"diab\": lambda s: s.map({1: 1, 2: 0, 3: 0, 4: 0}),\n","    \"age\":  lambda s: s.where(s.between(1, 13)),    # 14 = missing\n","    \"inc\":  lambda s: s.where(s.between(1, 11)),    # 77 / 99 -> NaN\n","    \"edu\":  lambda s: s.where(s.between(1, 6)),\n","    \"emp\":  lambda s: s.where(s.between(1, 8)),\n","    \"mar\":  lambda s: s.where(s.between(1, 6)),\n","    \"race\": lambda s: s.where(s.between(1, 8)),\n","    \"hous\": lambda s: s.where(s.between(1, 3)),\n","    \"sex\":  lambda s: s.map({1: 1, 2: 0}),          # 1 = male\n","    \"bmi\":  lambda s: s.where(s.between(1, 4)),\n","    \"gh\":   lambda s: s.where(s.between(1, 5)),\n","    \"d3\":   lambda s: s.where(s.between(1, 3)),\n","}\n","\n","# (feature name, [(raw column candidates, recode)])\n","DEMOG = [\n","    (\"age\", [(\"_AGEG5YR\", \"age\")]),\n","    (\"sex\", [(\"_SEX\", \"sex\"), (\"SEXVAR\", \"sex\")]),\n","    (\"race\", [(\"_IMPRACE\", \"race\"), (\"_RACE\", \"race\")]),\n","    (\"income\", [(\"INCOME3\", \"inc\"), (\"INCOME2\", \"inc\")]),\n","    (\"education\", [(\"EDUCA\", \"edu\")]),\n","    (\"employment\", [(\"EMPLOY1\", \"emp\")]),\n","    (\"marital\", [(\"MARITAL\", \"mar\")]),\n","    (\"housing\", [(\"RENTHOM1\", \"hous\")]),\n","    (\"insurance\", [(\"_HLTHPL1\", \"yn12\"), (\"_HLTHPLN\", \"yn12\"), (\"HLTHPLN1\", \"yn12\")]),\n","]\n","HEALTH = [\n","    (\"kidney_disease\", [(\"CHCKDNY2\", \"yn12\")]),\n","    (\"arthritis\", [(\"_DRDXAR3\", \"yn12\"), (\"_DRDXAR2\", \"yn12\"), (\"HAVARTH5\", \"yn12\"), (\"HAVARTH4\", \"yn12\")]),\n","    (\"diabetes\", [(\"DIABETE4\", \"diab\")]),\n","    (\"heart_attack\", [(\"CVDINFR4\", \"yn12\")]),\n","    (\"coronary_heart_disease\", [(\"CVDCRHD4\", \"yn12\")]),\n","    (\"stroke\", [(\"CVDSTRK3\", \"yn12\")]),\n","    (\"asthma\", [(\"ASTHMA3\", \"yn12\")]),\n","    (\"copd\", [(\"CHCCOPD3\", \"yn12\"), (\"CHCCOPD2\", \"yn12\")]),\n","    (\"depression\", [(\"ADDEPEV3\", \"yn12\"), (\"ADDEPEV2\", \"yn12\")]),\n","    (\"skin_cancer\", [(\"CHCSCNC1\", \"yn12\")]),\n","    (\"other_cancer\", [(\"CHCOCNC1\", \"yn12\")]),\n","    (\"hypertension\", [(\"_RFHYPE6\", \"rf12\"), (\"_RFHYPE5\", \"rf12\")]),\n","    (\"high_cholesterol\", [(\"_RFCHOL3\", \"rf12\"), (\"TOLDHI3\", \"yn12\")]),\n","    (\"bmi_category\", [(\"_BMI5CAT\", \"bmi\")]),\n","    (\"general_health\", [(\"GENHLTH\", \"gh\")]),\n","    (\"mental_health_days\", [(\"_MENT14D\", \"d3\")]),\n","    (\"physical_health_days\", [(\"_PHYS14D\", \"d3\")]),\n","    (\"hearing_difficulty\", [(\"DEAF\", \"yn12\")]),\n","    (\"vision_difficulty\", [(\"BLIND\", \"yn12\")]),\n","    (\"cognitive_difficulty\", [(\"DECIDE\", \"yn12\")]),\n","    (\"walking_difficulty\", [(\"DIFFWALK\", \"yn12\")]),\n","    (\"dressing_difficulty\", [(\"DIFFDRES\", \"yn12\")]),\n","    (\"errands_difficulty\", [(\"DIFFALON\", \"yn12\")]),\n","]\n","NOMINAL = {\"race\", \"employment\", \"marital\", \"housing\"}\n","DEMO_COLS = [n for n, _ in DEMOG]\n","HEALTH_COLS = [n for n, _ in HEALTH]\n","BINARY_CONDITIONS = [n for n in HEALTH_COLS if n not in\n","                     (\"bmi_category\", \"general_health\", \"mental_health_days\", \"physical_health_days\")]\n","\n","# ------------------------------- targets (lifestyle; NEVER used as inputs) -------------------------------\n","def t_alcohol_any(raw):\n","    s = raw[\"ALCDAY5\"]\n","    out = pd.Series(np.nan, index=raw.index)\n","    out[s == 888] = 0                                                    # no drinks in past 30 days\n","    out[((s >= 101) & (s <= 107)) | ((s >= 201) & (s <= 230))] = 1       # days per week / per month\n","    return out                                                           # 777 / 999 stay NaN\n","\n","TARGET_SPECS = {\n","    \"smoking\":            ([\"SMOKE100\"], lambda r: r[\"SMOKE100\"].map({1: 1, 2: 0})),\n","    \"alcohol_any\":        ([\"ALCDAY5\"],  t_alcohol_any),\n","    \"fitness_any\":        ([\"EXERANY2\"], lambda r: r[\"EXERANY2\"].map({1: 1, 2: 0})),\n","    \"alcohol_binge\":      ([\"_RFBING5\"], lambda r: r[\"_RFBING5\"].map({1: 0, 2: 1})),\n","    \"fitness_guidelines\": ([\"_PACAT3\"],  lambda r: r[\"_PACAT3\"].map({1: 1, 2: 1, 3: 0, 4: 0})),\n","}\n","\n","NEEDED = {\"_STATE\", \"_LLCPWT\"}\n","for _, cands in DEMOG + HEALTH:\n","    NEEDED.update(c for c, _ in cands)\n","for cols, _ in TARGET_SPECS.values():\n","    NEEDED.update(cols)\n","print(f\"{len(DEMO_COLS)} demographic + {len(HEALTH_COLS)} health features; {len(TARGET_SPECS)} candidate targets\")\n","\n","def demo_data(n=int(os.environ.get(\"BRFSS_DEMO_N\", 12000)), seed=0):\n","    \"\"\"Synthetic data using raw BRFSS names/codes; ONLY for a smoke test of this notebook.\"\"\"\n","    r = np.random.default_rng(seed)\n","    yn = lambda p: np.where(r.random(n) < p, 1, 2).astype(float)\n","    d = {}\n","    age = r.integers(1, 14, n).astype(float)\n","    d[\"_AGEG5YR\"] = np.where(r.random(n) < 0.02, 14, age)\n","    d[\"_SEX\"] = r.integers(1, 3, n).astype(float)\n","    d[\"_IMPRACE\"] = r.integers(1, 7, n).astype(float)\n","    d[\"INCOME3\"] = np.where(r.random(n) < 0.15, 99, r.integers(1, 12, n)).astype(float)\n","    d[\"EDUCA\"] = r.integers(1, 7, n).astype(float)\n","    d[\"EMPLOY1\"] = r.integers(1, 9, n).astype(float)\n","    d[\"MARITAL\"] = r.integers(1, 7, n).astype(float)\n","    d[\"RENTHOM1\"] = r.integers(1, 4, n).astype(float)\n","    d[\"_HLTHPL1\"] = yn(0.92)\n","    smoke = r.random(n) < (0.30 + 0.02 * (age > 5))\n","    d[\"SMOKE100\"] = np.where(smoke, 1, 2).astype(float)\n","    d[\"CHCKDNY2\"] = yn(0.04); d[\"_DRDXAR3\"] = yn(0.30); d[\"DIABETE4\"] = r.choice([1, 2, 3, 4], n, p=[.13, .01, .80, .06]).astype(float)\n","    d[\"CVDINFR4\"] = yn(0.05); d[\"CVDCRHD4\"] = yn(0.05); d[\"CVDSTRK3\"] = yn(0.04); d[\"ASTHMA3\"] = yn(0.14)\n","    d[\"CHCCOPD3\"] = np.where(r.random(n) < np.where(smoke, 0.12, 0.03), 1, 2).astype(float)\n","    d[\"ADDEPEV3\"] = yn(0.2); d[\"CHCSCNC1\"] = yn(0.07); d[\"CHCOCNC1\"] = yn(0.08)\n","    d[\"_RFHYPE6\"] = np.where(r.random(n) < 0.4, 2, 1).astype(float)\n","    d[\"_RFCHOL3\"] = np.where(r.random(n) < 0.38, 2, 1).astype(float)\n","    d[\"_BMI5CAT\"] = r.choice([1, 2, 3, 4], n, p=[.02, .3, .35, .33]).astype(float)\n","    d[\"GENHLTH\"] = r.integers(1, 6, n).astype(float)\n","    d[\"_MENT14D\"] = r.choice([1, 2, 3], n, p=[.7, .2, .1]).astype(float)\n","    d[\"_PHYS14D\"] = r.choice([1, 2, 3], n, p=[.65, .22, .13]).astype(float)\n","    for c, p in [(\"DEAF\", .08), (\"BLIND\", .05), (\"DECIDE\", .11), (\"DIFFWALK\", .16), (\"DIFFDRES\", .04), (\"DIFFALON\", .07)]:\n","        d[c] = yn(p)\n","    walk = d[\"DIFFWALK\"] == 1\n","    drink = r.random(n) < (0.60 - 0.15 * (d[\"CHCKDNY2\"] == 1) - 0.005 * (age > 9) * 10)\n","    d[\"ALCDAY5\"] = np.where(drink, r.choice([101, 103, 105, 205, 210, 215, 230], n), 888).astype(float)\n","    d[\"ALCDAY5\"] = np.where(r.random(n) < 0.02, 777, d[\"ALCDAY5\"])\n","    d[\"_RFBING5\"] = np.where(drink & (r.random(n) < 0.25), 2, 1).astype(float)\n","    active = r.random(n) < (0.85 - 0.30 * walk - 0.10 * (d[\"_DRDXAR3\"] == 1))\n","    d[\"EXERANY2\"] = np.where(active, 1, 2).astype(float)\n","    d[\"_PACAT3\"] = np.where(active, r.choice([1, 2, 3], n), 4).astype(float)\n","    d[\"_STATE\"] = r.integers(1, 40, n).astype(float)\n","    d[\"_LLCPWT\"] = r.lognormal(6, 1, n)\n","    df = pd.DataFrame(d)\n","    for c in [\"SMOKE100\", \"EXERANY2\", \"CHCKDNY2\", \"_RFHYPE6\"]:             # sprinkle refused/unknown codes\n","        df.loc[r.random(n) < 0.01, c] = 9\n","    for c in [\"_HLTHPL1\", \"DIABETE4\", \"_DRDXAR3\"]:\n","        df.loc[r.random(n) < 0.03, c] = np.nan\n","    return df\n","\n","# ---- CDC 2021 LLCP fixed-width layout (official column positions) ----\n","# (start_col 1-indexed, name, length) -> converted to 0-indexed (start,end) for pandas read_fwf\n","_LAYOUT = [\n"," (1,\"_STATE\",2),(101,\"GENHLTH\",1),(102,\"PHYSHLTH\",2),(104,\"MENTHLTH\",2),\n"," (108,\"PRIMINSR\",2),(110,\"PERSDOC3\",1),(112,\"CHECKUP1\",1),(113,\"EXERANY2\",1),\n"," (114,\"BPHIGH6\",1),(117,\"TOLDHI3\",1),(119,\"CVDINFR4\",1),(120,\"CVDCRHD4\",1),\n"," (121,\"CVDSTRK3\",1),(122,\"ASTHMA3\",1),(124,\"CHCSCNCR\",1),(125,\"CHCOCNCR\",1),\n"," (126,\"CHCCOPD3\",1),(127,\"ADDEPEV3\",1),(128,\"CHCKDNY2\",1),(129,\"DIABETE4\",1),\n"," (132,\"HAVARTH5\",1),(175,\"MARITAL\",1),(176,\"EDUCA\",1),(177,\"RENTHOM1\",1),\n"," (189,\"VETERAN3\",1),(190,\"EMPLOY1\",1),(193,\"INCOME3\",2),(204,\"DEAF\",1),\n"," (205,\"BLIND\",1),(206,\"DECIDE\",1),(207,\"DIFFWALK\",1),(208,\"DIFFDRES\",1),\n"," (209,\"DIFFALON\",1),(210,\"SMOKE100\",1),(214,\"ALCDAY5\",3),(1902,\"_HLTHPLN\",1),\n"," (1900,\"_PHYS14D\",1),(1901,\"_MENT14D\",1),(1905,\"_RFHYPE6\",1),(1907,\"_RFCHOL3\",1),\n"," (1912,\"_DRDXAR3\",1),(1978,\"_RACE\",1),(1982,\"_SEX\",1),(1983,\"_AGEG5YR\",2),\n"," (2004,\"_BMI5CAT\",1),(2016,\"_RFBING5\",1),(1751,\"_LLCPWT\",10),\n","]\n","# NOTE: positions below 175 (health core section) are missing from this excerpt list for brevity\n","# in the condensed table CDC publishes online; add any you need by the same (start,name,len) pattern\n","# from https://www.cdc.gov/brfss/annual_data/2021/llcp_varlayout_21_onecolumn.html\n","_COLSPECS = [(s - 1, s - 1 + l) for s, _, l in _LAYOUT]\n","_NAMES = [n for _, n, _ in _LAYOUT]\n","\n","def find_asc():\n","    hits = []\n","    for root in (\"/kaggle/input\", \".\"):\n","        if not os.path.isdir(root): continue\n","        for dirpath, _, files in os.walk(root):\n","            for f in files:\n","                if f.lower() == \"llcp2021.asc\":\n","                    hits.append(os.path.join(dirpath, f))\n","    hits.sort(key=os.path.getsize, reverse=True)\n","    return hits[0] if hits else None\n","\n","def find_csv():\n","    hits = []\n","    for root in (\"/kaggle/input\", \".\"):\n","        if not os.path.isdir(root): continue\n","        for dirpath, _, files in os.walk(root):\n","            for f in files:\n","                if f.lower().startswith(\"llcp2021\") and f.lower().endswith(\".csv\"):\n","                    hits.append(os.path.join(dirpath, f))\n","    hits.sort(key=os.path.getsize, reverse=True)\n","    return hits[0] if hits else None\n","\n","def load_raw():\n","    if DEMO:\n","        print(\"DEMO mode: synthetic data (not BRFSS)\"); return demo_data()\n","    print(\"Scanning /kaggle/input for LLCP2021.asc / .csv ...\")\n","    for root in (\"/kaggle/input\", \".\"):\n","        if os.path.isdir(root):\n","            for dirpath, _, files in os.walk(root):\n","                for f in files:\n","                    if \"llcp2021\" in f.lower():\n","                        print(\"  found:\", os.path.join(dirpath, f))\n","    asc = find_asc()\n","    if asc:\n","        print(\"Using fixed-width ASCII (CDC original):\", asc,\n","              f\"-- {len(_NAMES)} hard-coded columns; add rows to _LAYOUT if a variable you need is missing\")\n","        df = pd.read_fwf(asc, colspecs=_COLSPECS, names=_NAMES, dtype=str)\n","        for c in df.columns:\n","            df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n","        return df\n","    path = find_csv()\n","    assert path, \"Neither LLCP2021.asc nor a BRFSS csv found under /kaggle/input. Check the dataset is attached (right panel -> Add Input).\"\n","    print(\"ASC not found -- falling back to CSV mirror:\", path)\n","    header = pd.read_csv(path, nrows=0).columns\n","    mapping = {c: norm_col(c) for c in header}\n","    keep = [c for c, nm in mapping.items() if nm in NEEDED]\n","    df = pd.read_csv(path, usecols=keep, low_memory=False)\n","    df.columns = [mapping[c] for c in df.columns]\n","    return df.loc[:, ~df.columns.duplicated()]\n","\n","\n","t0 = time.time()\n","raw = load_raw()\n","print(\"raw shape:\", raw.shape, f\"({time.time()-t0:.0f}s)\")\n","\n","X = pd.DataFrame(index=raw.index)\n","USED = {}\n","for name, cands in DEMOG + HEALTH:\n","    for col, rec in cands:\n","        if col in raw.columns:\n","            X[name] = RECODE[rec](raw[col].astype(float)); USED[name] = col; break\n","    else:\n","        print(f\"  [skip] no column for '{name}' (tried {[c for c, _ in cands]})\")\n","\n","Y = {}\n","for tname, (cols, fn) in TARGET_SPECS.items():\n","    if all(c in raw.columns for c in cols):\n","        Y[tname] = fn(raw)\n","    else:\n","        print(f\"  [skip target] {tname}: missing {cols}\")\n","\n","print(\"\\nFeature missingness (share NaN):\")\n","print(X.isna().mean().round(3).sort_values(ascending=False).head(8).to_string())\n","print(\"\\nTarget prevalence (among valid answers):\")\n","for k, v in Y.items():\n","    print(f\"  {k:20s} n_valid={int(v.notna().sum()):>8,}  prevalence={v.mean():.3f}\")\n","FEATURES = list(X.columns)\n","W = raw[\"_LLCPWT\"] if \"_LLCPWT\" in raw.columns else None\n","STATE = raw[\"_STATE\"] if \"_STATE\" in raw.columns else None\n","\n","def make_pre(cols):\n","    nom = [c for c in cols if c in NOMINAL]\n","    num = [c for c in cols if c not in NOMINAL]\n","    tf = []\n","    if nom:\n","        tf.append((\"nom\", Pipeline([(\"imp\", SimpleImputer(strategy=\"most_frequent\")),\n","                                    (\"oh\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False))]), nom))\n","    if num:\n","        tf.append((\"num\", Pipeline([(\"imp\", SimpleImputer(strategy=\"median\", add_indicator=True)),\n","                                    (\"sc\", StandardScaler())]), num))\n","    return ColumnTransformer(tf)\n","\n","def make_gb():        # handles NaN natively\n","    return HistGradientBoostingClassifier(max_iter=300, learning_rate=0.08, max_leaf_nodes=31,\n","                                          early_stopping=True, random_state=SEED)\n","def make_xgb():\n","    return XGBClassifier(n_estimators=300, max_depth=5, learning_rate=0.08, subsample=0.8, colsample_bytree=0.8,\n","                         eval_metric=\"logloss\", tree_method=\"hist\", n_jobs=-1, random_state=SEED)\n","BOOST = make_xgb if HAS_XGB else make_gb\n","def make_rf():\n","    return RandomForestClassifier(n_estimators=150, min_samples_leaf=25, max_features=\"sqrt\", n_jobs=-1, random_state=SEED)\n","\n","def subsample(Xd, y, n):\n","    if n is None or len(y) <= n: return Xd, y\n","    i = np.random.default_rng(SEED).choice(len(y), n, replace=False)\n","    return Xd.iloc[i], y.iloc[i]\n","\n","def fit_models(Xtr, ytr):\n","    cols = list(Xtr.columns); ms = {}\n","    Xs, ys = subsample(Xtr, ytr, MAX_TRAIN_FAST if FAST else None)\n","    ms[\"LR\"] = Pipeline([(\"pre\", make_pre(cols)), (\"clf\", LogisticRegression(max_iter=1000))]).fit(Xtr, ytr)\n","    ms[\"HGB_native\"] = make_gb().fit(Xtr, ytr)\n","    if HAS_XGB:\n","        ms[\"XGB\"] = Pipeline([(\"pre\", make_pre(cols)), (\"clf\", make_xgb())]).fit(Xtr, ytr)\n","    ms[\"RF\"] = Pipeline([(\"pre\", make_pre(cols)), (\"clf\", make_rf())]).fit(Xs, ys)\n","    stack = StackingClassifier(\n","        estimators=[(\"lr\", LogisticRegression(max_iter=1000)), (\"rf\", make_rf()), (\"gb\", BOOST())],\n","        final_estimator=MLPClassifier(hidden_layer_sizes=(32,), max_iter=300, early_stopping=True, random_state=SEED),\n","        cv=STACK_CV, stack_method=\"predict_proba\", n_jobs=1)\n","    ms[\"Stacked\"] = Pipeline([(\"pre\", make_pre(cols)), (\"clf\", stack)]).fit(Xs, ys)\n","    return ms\n","\n","R = {}\n","for tname in TARGETS_TO_RUN:\n","    if tname not in Y: continue\n","    t0 = time.time()\n","    y = Y[tname].dropna().astype(int)\n","    tr, te = train_test_split(y.index, test_size=0.20, stratify=y, random_state=SEED)\n","    tr, va = train_test_split(tr, test_size=0.15, stratify=y.loc[tr], random_state=SEED)\n","    models = fit_models(X.loc[tr], y.loc[tr])\n","    R[tname] = dict(y=y, tr=tr, va=va, te=te, models=models,\n","                    pv={k: m.predict_proba(X.loc[va])[:, 1] for k, m in models.items()},\n","                    pt={k: m.predict_proba(X.loc[te])[:, 1] for k, m in models.items()})\n","    print(f\"[{tname}] train={len(tr):,} val={len(va):,} test={len(te):,} prevalence={y.mean():.3f}  ({time.time()-t0:.0f}s)\")\n","\n","def pick_threshold(yv, pv, recall=THRESH_RECALL):\n","    fpr, tpr, thr = roc_curve(yv, pv)\n","    return float(thr[int(np.argmax(tpr >= recall))])\n","\n","def metrics(y, p, thr, top=TOP_FRAC):\n","    y = np.asarray(y); pred = (p >= thr).astype(int)\n","    tn, fp, fn, tp = confusion_matrix(y, pred, labels=[0, 1]).ravel()\n","    sens, spec = tp / max(tp + fn, 1), tn / max(tn + fp, 1)\n","    k = max(int(len(p) * top), 1); hits = y[np.argsort(-p)][:k].sum()\n","    return {\"AUROC\": roc_auc_score(y, p), \"Brier\": brier_score_loss(y, p), \"Threshold\": thr,\n","            \"Sensitivity\": sens, \"Specificity\": spec, \"PPV\": tp / max(tp + fp, 1), \"NPV\": tn / max(tn + fn, 1),\n","            \"BalAcc\": (sens + spec) / 2, f\"Capture@{int(top*100)}\": hits / y.sum(), f\"Lift@{int(top*100)}\": (hits / k) / y.mean()}\n","\n","def boot_auc(y, p, n=N_BOOT, seed=SEED):\n","    rng = np.random.default_rng(seed); y = np.asarray(y); a = []\n","    for _ in range(n):\n","        i = rng.integers(0, len(y), len(y))\n","        if y[i].min() != y[i].max(): a.append(roc_auc_score(y[i], p[i]))\n","    return np.percentile(a, [2.5, 97.5])\n","\n","def boot_delta(y, p_new, p_base, n=N_BOOT, seed=SEED):\n","    rng = np.random.default_rng(seed); y = np.asarray(y); d = []\n","    for _ in range(n):\n","        i = rng.integers(0, len(y), len(y))\n","        if y[i].min() != y[i].max(): d.append(roc_auc_score(y[i], p_new[i]) - roc_auc_score(y[i], p_base[i]))\n","    return float(np.mean(d)), np.percentile(d, [2.5, 97.5])\n","\n","rows = []\n","for t, r in R.items():\n","    yv, yt = r[\"y\"].loc[r[\"va\"]].values, r[\"y\"].loc[r[\"te\"]].values\n","    r[\"val_auc\"] = {m: roc_auc_score(yv, r[\"pv\"][m]) for m in r[\"models\"]}\n","    r[\"best\"] = max(r[\"val_auc\"], key=r[\"val_auc\"].get)            # chosen on VALIDATION, not test\n","    r[\"thr\"] = {m: pick_threshold(yv, r[\"pv\"][m]) for m in r[\"models\"]}\n","    for m in r[\"models\"]:\n","        for op, thr in [(\"thr=0.5\", 0.5), (f\"recall>={THRESH_RECALL:.2f}\", r[\"thr\"][m])]:\n","            rows.append({\"target\": t, \"model\": m, \"operating_point\": op, **metrics(yt, r[\"pt\"][m], thr)})\n","perf = pd.DataFrame(rows)\n","perf.to_csv(f\"{OUT}/performance_all_models.csv\", index=False)\n","\n","pd.set_option(\"display.width\", 200); pd.set_option(\"display.max_columns\", 20)\n","for t, r in R.items():\n","    print(f\"\\n=== {t}  (best on validation: {r['best']}) ===\")\n","    print(perf[(perf.target == t) & (perf.operating_point.str.startswith(\"recall\"))]\n","          .drop(columns=[\"target\", \"operating_point\"]).round(3).to_string(index=False))\n","\n","headline = []\n","for t, r in R.items():\n","    b = r[\"best\"]; te = r[\"te\"]; yt = r[\"y\"].loc[te].values; pt = r[\"pt\"][b]\n","    lo, hi = boot_auc(yt, pt)\n","    row = {\"target\": t, \"best_model\": b, \"prevalence\": yt.mean(), \"AUROC\": roc_auc_score(yt, pt), \"AUROC_CI_low\": lo, \"AUROC_CI_high\": hi}\n","    if W is not None:\n","        row[\"AUROC_survey_weighted\"] = roc_auc_score(yt, pt, sample_weight=W.loc[te].values)\n","    row.update({k: v for k, v in metrics(yt, pt, r[\"thr\"][b]).items() if k in (\"Sensitivity\", \"Specificity\", \"PPV\", f\"Capture@{int(TOP_FRAC*100)}\", f\"Lift@{int(TOP_FRAC*100)}\")})\n","    headline.append(row)\n","    dec = pd.qcut(pd.Series(pt).rank(method=\"first\", ascending=False), 10, labels=False) + 1\n","    g = pd.DataFrame({\"decile\": dec, \"y\": yt}).groupby(\"decile\")[\"y\"].agg([\"size\", \"mean\", \"sum\"])\n","    g[\"lift\"] = g[\"mean\"] / yt.mean(); g[\"cum_capture\"] = g[\"sum\"].cumsum() / yt.sum()\n","    g.round(3).to_csv(f\"{OUT}/gains_table_{t}.csv\")\n","    r[\"gains\"] = g\n","headline = pd.DataFrame(headline)\n","headline.to_csv(f\"{OUT}/headline_results.csv\", index=False)\n","print(headline.round(3).to_string(index=False))\n","\n","if HAS_PLT and R:\n","    fig, ax = plt.subplots(figsize=(5.5, 4.5))\n","    for t, r in R.items():\n","        yt = r[\"y\"].loc[r[\"te\"]].values; p = r[\"pt\"][r[\"best\"]]\n","        o = np.argsort(-p); cum = np.cumsum(yt[o]) / yt.sum(); x = np.arange(1, len(yt) + 1) / len(yt)\n","        s = max(1, len(x) // 400); ax.plot(x[::s], cum[::s], label=f\"{t} ({r['best']})\")\n","    ax.plot([0, 1], [0, 1], \"k--\", lw=1, label=\"random\"); ax.axvline(TOP_FRAC, color=\"grey\", lw=0.8)\n","    ax.set_xlabel(\"Share of people contacted (highest score first)\"); ax.set_ylabel(\"Share of target consumers captured\")\n","    ax.set_title(\"Cumulative gains (test set)\"); ax.legend(fontsize=8); fig.tight_layout()\n","    fig.savefig(f\"{OUT}/fig_cumulative_gains.png\", dpi=200); plt.show()\n","\n","abl_rows = []\n","for t, r in R.items():\n","    y, tr, te = r[\"y\"], r[\"tr\"], r[\"te\"]; yt = y.loc[te].values\n","    sets = {\"Demographics only\": DEMO_COLS, \"Health only\": HEALTH_COLS, \"Demographics + Health\": DEMO_COLS + HEALTH_COLS}\n","    preds = {}\n","    for label, cols in sets.items():\n","        cols = [c for c in cols if c in X.columns]\n","        preds[label] = make_gb().fit(X.loc[tr, cols], y.loc[tr]).predict_proba(X.loc[te, cols])[:, 1]\n","    for label, p in preds.items():\n","        lo, hi = boot_auc(yt, p)\n","        row = {\"target\": t, \"feature_set\": label, \"AUROC\": roc_auc_score(yt, p), \"CI_low\": lo, \"CI_high\": hi}\n","        if label != \"Demographics only\":\n","            d, (dlo, dhi) = boot_delta(y