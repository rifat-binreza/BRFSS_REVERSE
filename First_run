,"            Xt = pre.transform(X.loc[te_sub]); names = [group_name(n) for n in pre.get_feature_names_out()]\n","            sv = shap.TreeExplainer(pipe.named_steps[\"clf\"]).shap_values(Xt)\n","            sv = sv[1] if isinstance(sv, list) else sv\n","            imp = pd.Series(np.abs(sv).mean(0), index=names).groupby(level=0).sum(); how = \"mean|SHAP|\"\n","        except Exception as e:\n","            print(f\"[{t}] SHAP failed ({e}); using permutation importance\")\n","    if imp is None:\n","        sub = r[\"te\"][:20000]\n","        pi = permutation_importance(r[\"models\"][\"HGB_native\"], X.loc[sub], r[\"y\"].loc[sub], scoring=\"roc_auc\",\n","                                    n_repeats=3, random_state=SEED, n_jobs=1)\n","        imp = pd.Series(pi.importances_mean, index=X.columns); how = \"permutation AUROC drop\"\n","    imp = imp.sort_values(ascending=False)\n","    imp_all.append(imp.rename(t))\n","    print(f\"\\n{t}  top features by {how}:\\n\" + imp.head(10).round(4).to_string())\n","    if HAS_PLT:\n","        fig, ax = plt.subplots(figsize=(5.5, 4)); imp.head(12)[::-1].plot.barh(ax=ax)\n","        ax.set_title(f\"{t}: {how}\"); fig.tight_layout(); fig.savefig(f\"{OUT}/fig_importance_{t}.png\", dpi=200); plt.show()\n","pd.concat(imp_all, axis=1).to_csv(f\"{OUT}/feature_importance.csv\")\n","\n","sg = []\n","for t, r in R.items():\n","    b, te = r[\"best\"], r[\"te\"]; yt = r[\"y\"].loc[te]; pt = pd.Series(r[\"pt\"][b], index=te); thr = r[\"thr\"][b]\n","    groups = {\n","        \"sex\": X.loc[te, \"sex\"].map({1: \"male\", 0: \"female\"}),\n","        \"age\": pd.cut(X.loc[te, \"age\"], [0, 5, 9, 13], labels=[\"18-44\", \"45-64\", \"65+\"]),\n","        \"race\": X.loc[te, \"race\"].map({1: \"White\", 2: \"Black\", 3: \"AmInd/AK\", 4: \"Asian\", 5: \"NHPI\", 6: \"Other/Multi\", 7: \"Multi\", 8: \"Hispanic\"}),\n","    }\n","    for gname, gs in groups.items():\n","        for lvl in gs.dropna().unique():\n","            m = (gs == lvl).values; yy, pp = yt.values[m], pt.values[m]\n","            if m.sum() < 300 or yy.sum() < 50 or (yy == 0).sum() < 50: continue\n","            sg.append({\"target\": t, \"group\": gname, \"level\": str(lvl), \"n\": int(m.sum()), \"prevalence\": yy.mean(),\n","                       \"AUROC\": roc_auc_score(yy, pp), \"Sensitivity\": ((pp >= thr) & (yy == 1)).sum() / yy.sum()})\n","subgroups = pd.DataFrame(sg)\n","subgroups.to_csv(f\"{OUT}/subgroup_performance.csv\", index=False)\n","print(subgroups.round(3).to_string(index=False))\n","\n","ho = []\n","if STATE is None:\n","    print(\"No _STATE column: skipped.\")\n","else:\n","    for t, r in R.items():\n","        y = r[\"y\"]; g = STATE.loc[y.index]\n","        tr_i, te_i = next(GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=SEED).split(y.index, groups=g))\n","        Xtr, ytr, Xte, yte = X.loc[y.index[tr_i]], y.iloc[tr_i], X.loc[y.index[te_i]], y.iloc[te_i]\n","        p = make_gb().fit(Xtr, ytr).predict_proba(Xte)[:, 1]\n","        lo, hi = boot_auc(yte.values, p)\n","        ho.append({\"target\": t, \"n_train_states\": int(g.iloc[tr_i].nunique()), \"n_test_states\": int(g.iloc[te_i].nunique()),\n","                   \"AUROC_unseen_states\": roc_auc_score(yte, p), \"CI_low\": lo, \"CI_high\": hi,\n","                   \"AUROC_random_split_same_model\": roc_auc_score(r[\"y\"].loc[r[\"te\"]], r[\"pt\"][\"HGB_native\"])})\n","    ho = pd.DataFrame(ho); ho.to_csv(f\"{OUT}/state_holdout.csv\", index=False)\n","    print(ho.round(3).to_string(index=False))\n","\n","print(\"=\" * 78)\n","print(\"SUMMARY (paste everything between the lines)\")\n","print(\"=\" * 78)\n","print(\"data rows:\", len(raw), \"| features used:\", len(FEATURES), \"| xgboost:\", HAS_XGB, \"| shap:\", HAS_SHAP, \"| demo:\", DEMO)\n","print(\"\\nHEADLINE (best model chosen on validation):\")\n","print(headline.round(3).to_string(index=False))\n","print(\"\\nABLATION (HGB, AUROC + delta vs demographics-only):\")\n","print(ablation.round